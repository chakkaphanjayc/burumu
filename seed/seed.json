{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Burumu",
    "description": "Thai-first bilingual service website for Burumu",
    "author": "Burumu"
  },
  "settings": {
    "title": "Burumu",
    "tagline": "ระบบธุรกิจ การตลาด คอนเทนต์ และเกม"
  },
  "blockTypes": [
    {
      "slug": "marketing_hero",
      "label": "Hero",
      "description": "Page introduction, key message, and calls to action",
      "category": "Burumu",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            { "slug": "anchor_id", "label": "Anchor ID", "type": "string", "validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" } },
            { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
            { "slug": "headline", "label": "Headline", "type": "string", "required": true },
            { "slug": "subheadline", "label": "Description", "type": "text" },
            { "slug": "primary_cta_label", "label": "Primary button label", "type": "string" },
            { "slug": "primary_cta_url", "label": "Primary button URL", "type": "string", "validation": { "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$" } },
            { "slug": "secondary_cta_label", "label": "Secondary button label", "type": "string" },
            { "slug": "secondary_cta_url", "label": "Secondary button URL", "type": "string", "validation": { "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$" } }
          ]
        }
      ]
    },
    {
      "slug": "marketing_features",
      "label": "Services",
      "description": "Burumu service cards",
      "category": "Burumu",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            { "slug": "anchor_id", "label": "Anchor ID", "type": "string", "validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" } },
            { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
            { "slug": "headline", "label": "Heading", "type": "string", "required": true },
            { "slug": "subheadline", "label": "Description", "type": "text" },
            {
              "slug": "features",
              "label": "Services",
              "type": "repeater",
              "required": true,
              "validation": {
                "minItems": 1,
                "maxItems": 8,
                "subFields": [
                  { "slug": "number", "label": "Number", "type": "string", "required": true },
                  { "slug": "label", "label": "Category label", "type": "string", "required": true },
                  { "slug": "title", "label": "Service name", "type": "string", "required": true },
                  { "slug": "description", "label": "Description", "type": "text", "required": true }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "slug": "marketing_cta",
      "label": "Enquiry call to action",
      "description": "Closing enquiry prompt",
      "category": "Burumu",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            { "slug": "anchor_id", "label": "Anchor ID", "type": "string", "validation": { "pattern": "^(?:$|[a-z][a-z0-9_-]*)$" } },
            { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
            { "slug": "headline", "label": "Heading", "type": "string", "required": true },
            { "slug": "subheadline", "label": "Description", "type": "text" },
            { "slug": "button_label", "label": "Button label", "type": "string", "required": true },
            { "slug": "button_url", "label": "Button URL", "type": "string", "validation": { "pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$" } }
          ]
        }
      ]
    }
  ],
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": ["drafts", "revisions", "seo"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        {
          "slug": "content",
          "label": "Content",
          "type": "blocks",
          "validation": {
            "allowedTypes": ["marketing_hero", "marketing_features", "marketing_cta"],
            "maxItems": 12
          }
        }
      ]
    }
  ],
  "content": {
    "pages": [
