---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";

const slug = Astro.params.slug ? decodeSlug(Astro.params.slug) : null;
if (!slug) return Astro.rewrite("/404");
if (slug === "home") return Astro.redirect("/");

const { entry: page, error, cacheHint } = await getEmDashEntry("pages", slug, { locale: "th" });
if (error) {
	console.error("Failed to load page:", error);
	return new Response("Unable to load this page", { status: 500 });
}
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const description = "บริการ Odoo, วิเคราะห์การตลาด, ออกแบบกราฟิกและคอนเทนต์ ไปจนถึงพัฒนาเกม Unity และเว็บ โดย Burumu";
const pagePath = `/${encodeURIComponent(slug)}`;
const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: pagePath,
	defaultDescription: description,
});
---

<Base
	title={seo?.title ?? page.data.title}
	description={seo?.description ?? description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	locale="th"
	localePath={pagePath}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	{page.data.content?.length ? (
		<div {...page.edit.content}>
			<MarketingBlocks value={page.data.content} />
		</div>
	) : (
		<section class="empty-page">
			<h1>{page.data.title}</h1>
		</section>
	)}
</Base>

<style>
	.empty-page {
		width: min(100% - 3rem, 960px);
		min-height: 50vh;
		margin: 0 auto;
		padding: 6rem 0 2rem;
	}
	.empty-page h1 {
		max-width: 18ch;
		font-size: clamp(2.7rem, 7vw, 5.2rem);
		font-weight: 850;
		letter-spacing: -0.075em;
	}
	@media (max-width: 600px) {
		.empty-page { width: min(100% - 2rem, 960px); padding-top: 4.3rem; }
	}
</style>
