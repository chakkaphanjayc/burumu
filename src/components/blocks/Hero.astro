---
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section id={value.anchor_id || undefined} class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			{value.eyebrow && <p class="hero-eyebrow"><span class="eyebrow-dot"></span>{value.eyebrow}</p>}
			<h1 class="hero-headline">{value.headline}</h1>
			{value.subheadline && <p class="hero-subheadline">{value.subheadline}</p>}
			{(primaryCta || secondaryCta) && (
				<div class="hero-actions">
					{primaryCta && (
						<a href={primaryCta.url} class="btn btn-primary btn-lg">
							{primaryCta.label}<span aria-hidden="true">↗</span>
						</a>
					)}
					{secondaryCta && (
						<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
							{secondaryCta.label}
						</a>
					)}
				</div>
			)}
		</div>
		<div class="hero-art" aria-hidden="true">
			<div class="art-orbit orbit-one"></div>
			<div class="art-orbit orbit-two"></div>
			<div class="art-block">
				<span class="art-b">B</span>
				<span class="art-dot"></span>
			</div>
			<span class="art-label label-systems"><i>01</i> ODOO</span>
			<span class="art-label label-content"><i>02</i> CONTENT</span>
			<span class="art-label label-games"><i>03</i> GAMES</span>
			<span class="art-caption">IDEAS INTO DIGITAL WORK</span>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}
	.hero::before {
		position: absolute;
		top: 0;
		right: max(-10vw, -9rem);
		width: min(60vw, 52rem);
		height: 100%;
		background: linear-gradient(135deg, rgba(232, 91, 50, 0.08), rgba(237, 190, 72, 0.11));
		content: "";
		pointer-events: none;
	}
	.hero-inner {
		position: relative;
		display: grid;
		width: min(100% - 3rem, 1160px);
		min-height: 39rem;
		grid-template-columns: 1.08fr 0.92fr;
		align-items: center;
		gap: 3rem;
		margin-inline: auto;
		padding-block: 5.2rem 5.5rem;
	}
	.hero-copy { position: relative; z-index: 1; max-width: 38rem; }
	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 1.4rem;
		color: var(--color-brand);
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.eyebrow-dot { width: 0.52rem; height: 0.52rem; border-radius: 50%; background: currentColor; }
	.hero-headline {
		max-width: 13ch;
		margin-bottom: 1.3rem;
		font-size: clamp(3rem, 5.5vw, 5.25rem);
		font-weight: 850;
		letter-spacing: -0.075em;
		line-height: 1.04;
	}
	.hero-subheadline { max-width: 35rem; margin-bottom: 1.85rem; color: var(--color-muted); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.85; }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
	.btn-lg { min-height: 3.3rem; padding: 0.8rem 1.18rem; }
	.hero-art { position: relative; width: min(100%, 31rem); aspect-ratio: 1 / 0.92; justify-self: end; }
	.art-orbit {
		position: absolute;
		border: 1px solid rgba(35, 37, 31, 0.12);
		border-radius: 50%;
		transform: rotate(-24deg);
	}
	.orbit-one { inset: 10% 2% 6% 11%; }
	.orbit-two { inset: 19% 10% 15% 2%; transform: rotate(34deg); }
	.art-block {
		position: absolute;
		top: 50%;
		left: 49%;
		display: grid;
		width: 58%;
		aspect-ratio: 1;
		place-items: center;
		transform: translate(-50%, -50%) rotate(-7deg);
		border-radius: 30% 22% 27% 22%;
		color: #fbf7ef;
		background: var(--color-text);
		box-shadow: 1rem 1.3rem 0 rgba(232, 91, 50, 0.18), 0 2.5rem 5rem rgba(37, 38, 32, 0.15);
	}
	.art-b { margin-right: 0.08em; font-size: clamp(10rem, 21vw, 19rem); font-weight: 900; letter-spacing: -0.14em; line-height: 0.8; }
	.art-dot { position: absolute; top: 17%; right: 18%; width: 1rem; height: 1rem; border-radius: 50%; background: var(--color-brand); }
	.art-label {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 0.62rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid rgba(42, 43, 37, 0.09);
		border-radius: 0.5rem;
		color: var(--color-text);
		background: rgba(255, 254, 250, 0.94);
		box-shadow: 0 0.7rem 2rem rgba(34, 35, 29, 0.09);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.07em;
	}
	.art-label i { color: var(--color-brand); font-size: 0.62rem; font-style: normal; }
	.label-systems { top: 11%; right: 2%; }
	.label-content { top: 49%; left: -5%; }
	.label-games { right: 2%; bottom: 16%; }
	.art-caption { position: absolute; right: 9%; bottom: 0; color: var(--color-muted); font-size: 0.57rem; font-weight: 800; letter-spacing: 0.2em; }
	@media (max-width: 900px) {
		.hero-inner { min-height: 0; grid-template-columns: 1fr; gap: 1rem; padding-block: 4rem 3.5rem; }
		.hero-copy { max-width: 46rem; }
		.hero-headline { max-width: 15ch; font-size: clamp(3.2rem, 9vw, 5.2rem); }
		.hero-art { width: min(100%, 31rem); margin: 0 auto; justify-self: center; }
		.hero::before { top: 47%; right: -13rem; width: 100%; height: 55%; }
	}
	@media (max-width: 600px) {
		.hero-inner { width: min(100% - 2rem, 1160px); padding-top: 3.3rem; }
		.hero-headline { max-width: 12ch; font-size: clamp(2.8rem, 13vw, 4rem); }
		.hero-subheadline { font-size: 1rem; }
		.hero-actions { align-items: stretch; flex-direction: column; }
		.hero-actions .btn { width: 100%; }
		.hero-art { width: 94%; margin-top: 0.5rem; }
		.art-label { gap: 0.4rem; padding: 0.55rem 0.65rem; font-size: 0.58rem; }
		.label-content { left: -3%; }
		.art-b { font-size: clamp(9rem, 45vw, 14rem); }
	}
	@media (prefers-reduced-motion: no-preference) {
		.art-block { animation: settle 750ms cubic-bezier(.2,.7,.2,1) both; }
		@keyframes settle { from { opacity: 0; transform: translate(-50%, -46%) rotate(-2deg) scale(.92); } to { opacity: 1; transform: translate(-50%, -50%) rotate(-7deg) scale(1); } }
	}
</style>
